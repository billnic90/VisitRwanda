@model IEnumerable<VisitRwanda.Models.Destination>

@{
    ViewData["Title"] = "Tourist Destinations";
}

<h2 class="mt-4 mb-4 text-center">Top Destinations in Rwanda</h2>

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var d in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="row g-0 h-100">
                    <div class="col-4">
                        <img src="~/images/@d.Image"
                             class="img-fluid rounded-start h-100"
                             style="object-fit: cover;"
                             alt="@d.Name" />
                    </div>
                    <div class="col-8">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@d.Name</h5>
                            <p class="card-text flex-grow-1">@d.Description</p>
                            <p class="card-text text-muted"><em>@d.Location</em></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>