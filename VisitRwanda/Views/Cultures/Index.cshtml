@model IEnumerable<VisitRwanda.Models.Culture>

@{
    ViewData["Title"] = "Rwandan Culture And Heritage";
}

<h2 class="mt-4 mb-4 text-center">@ViewData["Title"]</h2>

@if (!Model.Any())
{
    <p class="text-center text-muted">
        No cultural entries available yet.
    </p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var c in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="row g-0 h-100">
                        <div class="col-4">
                            <img src="~/images/@c.Image"
                                 class="img-fluid rounded-start h-100"
                                 style="object-fit: cover;"
                                 alt="@c.Title" />
                        </div>
                        <div class="col-8">
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@c.Title</h5>
                                <p class="card-text flex-grow-1">@c.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
