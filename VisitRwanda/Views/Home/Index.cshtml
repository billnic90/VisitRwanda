@{
    ViewData["Title"] = "Welcome to Visit Rwanda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .carousel-item {
        height: 100vh;
        background-size: cover;
        background-position: center;
        position: relative;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1;
    }

    .hero-content {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        text-align: center;
        color: white;
    }

        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: bold;
        }

        .hero-content p {
            font-size: 1.5rem;
            margin-bottom: 20px;
        }

        .hero-content .btn {
            margin: 5px;
        }
</style>

<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
    <div class="carousel-inner">
        <div class="carousel-item active" style="background-image: url('/images/Night.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/VolcanoeChain.jpg');">
            <div class="overlay"></div>
        </div>

        <div class="carousel-item" style="background-image: url('/images/moreFireWorks.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/Karongi.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/Hiking.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/volcanoe.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/KwitaIzina.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/BisateLodge.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/Gisenyi.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/akageraAerial.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/Akagera.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/Leopard.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/AkageraHippos.jpg');">
            <div class="overlay"></div>
        </div>
        <div class="carousel-item" style="background-image: url('/images/hand.jpg');">
            <div class="overlay"></div>
        </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>


    <div class="hero-content">
        <h1>Visit Rwanda</h1>
        <p>The Land of a Thousand Hills</p>
        <div>
            <a asp-controller="Destinations" asp-action="Index" class="btn btn-outline-light">Explore Tourism</a>
            <a asp-controller="Cultures" asp-action="Index" class="btn btn-outline-light">Discover Culture</a>
            <a asp-controller="Investments" asp-action="Index" class="btn btn-outline-light">Invest Now</a>
        </div>
    </div>
</div>